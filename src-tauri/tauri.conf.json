{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "slate",
  "version": "0.1.0",
  "identifier": "dev.mirako.slate",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "slate",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 260,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "mirako",
    "shortDescription": "A notepad that keeps what you typed",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "log",
          "json",
          "toml",
          "yaml",
          "yml",
          "ini",
          "cfg",
          "env"
        ],
        "name": "Text",
        "description": "Text file",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./hooks.nsh",
        "minimumWebview2Version": "110.0.0.0"
      }
    },
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    }
  }
}
